# LLM Configuration
GEMINI_API_KEY='your-gemini-api-key-here'
GEMINI_MODEL_NAME='gemini-3.5-flash'


# Database Configuration (PostgreSQL)
DATABASE_URL='postgresql://aegis_readonly:aegis_readonly_password@localhost:5432/aegisdb'

# Qdrant Vector Database
QDRANT_HOST='localhost'
QDRANT_PORT=6333
QDRANT_COLLECTION='enterprise_documents'
QDRANT_PREFER_MEMORY=true   # set to false only if you have a persistent Qdrant Cloud URL configured

# Redis Cache
REDIS_URL='redis://localhost:6379/0'
REDIS_ENABLED=true
CACHE_TTL_SECONDS=3600

# Observability (LangSmith / Jaeger)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=''
LANGSMITH_PROJECT='agentic-enterprise-copilot'
LANGSMITH_ENDPOINT='https://api.smith.langchain.com'
JAEGER_ENABLED=true
JAEGER_HOST='localhost'
JAEGER_PORT=4318
JAEGER_ENDPOINT='http://localhost:4318/v1/traces'

# Guardrails
GUARDRAILS_ENABLED=true
INJECTION_STRICTNESS=0.85